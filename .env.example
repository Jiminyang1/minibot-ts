# Copy to ~/.minibot/.env (or $MINIBOT_HOME/.env). Real environment variables win.

# Model: provider/model from the pi-ai catalog, and that provider's key.
MINIBOT_MODEL=deepseek/deepseek-v4-pro
DEEPSEEK_API_KEY=

# Reasoning effort: off, minimal, low, medium, high, xhigh, max.
# MINIBOT_THINKING=medium

# Output ceiling per request (capped at the model's maximum).
# MINIBOT_MAX_OUTPUT_TOKENS=32000

# Compact when a request grows past this many tokens (default: the hard input limit).
# MINIBOT_COMPACT_THRESHOLD=300000
# MINIBOT_KEEP_RECENT_TOKENS=16000

# ask: confirm sensitive tools; always: approve them automatically.
# MINIBOT_APPROVAL=ask

# MINIBOT_MAX_ITERATIONS=20
# MINIBOT_MAX_RETRIES=3

# Langfuse tracing. Uploads every request, memory and app data included.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
