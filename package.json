{
  "name": "minibot",
  "version": "0.1.0",
  "description": "A personal AI assistant that runs on your machine: tools, memory, skills, schedules, MCP.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "minibot": "bin/minibot.js",
    "minibot-server": "bin/minibot-server.js",
    "minibot-daemon": "bin/minibot-daemon.js",
    "minibot-evals": "bin/minibot-evals.js"
  },
  "scripts": {
    "start": "node src/cli/main.ts",
    "server": "node src/server/main.ts",
    "daemon": "node src/scheduler/main.ts",
    "evals": "node src/evals/main.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-mcp": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
